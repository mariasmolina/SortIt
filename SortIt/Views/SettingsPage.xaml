<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:SortIt.Resources.Constants"
             xmlns:vm="clr-namespace:SortIt.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SortIt.Views.SettingsPage"
             Title="{Binding Settings_Title}"
             Background="{DynamicResource PageBackgroundBrush}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    
    <ContentPage.BindingContext>
        <vm:LanguageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="10" Margin="0,30,0,0">

            <Image Source="{x:Static resx:ImageResources.game_logo}"
                   WidthRequest="200"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   Margin="0,0,0,30"/>
            
            <!-- Language -->
            <Frame Padding="16"
                   Margin="15"
                   CornerRadius="20"
                   HasShadow="True"
                   HorizontalOptions="FillAndExpand"
                   Style="{DynamicResource GlobalFrameStyle}">

                <Grid ColumnDefinitions="*,auto" ColumnSpacing="12" VerticalOptions="Center">

                    <Label Text="{Binding Settings_Language}"
                           FontAttributes="Bold"
                           FontSize="18"
                           VerticalOptions="Center"
                           Style="{DynamicResource GlobalTitleLabelStyle}"/>

                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="10"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">

                        <!-- EN -->
                        <Button Command="{Binding SetEnglishCommand}"
                                BackgroundColor="Transparent"
                                Padding="8"
                                WidthRequest="40" HeightRequest="40"
                                CornerRadius="20"
                                BorderWidth="2">
                            <Button.ImageSource>
                                <FileImageSource File="{x:Static resx:ImageResources.flag_en}" />
                            </Button.ImageSource>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLanguage}"
                                             Value="en">
                                    <Setter Property="BorderColor" Value="#2E7D32"/>
                                    <Setter Property="BackgroundColor" Value="#E9F6EA"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- ET -->
                        <Button Command="{Binding SetEstonianCommand}"
                                BackgroundColor="Transparent"
                                Padding="8"
                                WidthRequest="40" HeightRequest="40"
                                CornerRadius="20"
                                BorderWidth="2">
                            <Button.ImageSource>
                                <FileImageSource File="{x:Static resx:ImageResources.flag_et}" />
                            </Button.ImageSource>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLanguage}"
                                             Value="et">
                                    <Setter Property="BorderColor" Value="#2E7D32"/>
                                    <Setter Property="BackgroundColor" Value="#E9F6EA"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- RU -->
                        <Button Command="{Binding SetRussianCommand}"
                                BackgroundColor="Transparent"
                                Padding="8"
                                WidthRequest="40" HeightRequest="40"
                                CornerRadius="20"
                                BorderWidth="2">
                            <Button.ImageSource>
                                <FileImageSource File="{x:Static resx:ImageResources.flag_ru}" />
                            </Button.ImageSource>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLanguage}"
                                             Value="ru">
                                    <Setter Property="BorderColor" Value="#2E7D32"/>
                                    <Setter Property="BackgroundColor" Value="#E9F6EA"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Theme -->
            <Frame Padding="16"
                   Margin="15"
                   CornerRadius="20"
                   HasShadow="True"
                   HorizontalOptions="FillAndExpand"
                   Style="{DynamicResource GlobalFrameStyle}">  

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                    <Label Text="{Binding Settings_Theme}"
                           FontAttributes="Bold"
                           FontSize="18"
                           VerticalOptions="Center"
                           Style="{DynamicResource GlobalTitleLabelStyle}"/>

                    <Border Grid.Column="1"
                            WidthRequest="190"
                            HeightRequest="46"
                            Stroke="#D6D6D6"
                            StrokeThickness="2"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 23">

                        <Grid ColumnDefinitions="*,*">

                            <Border x:Name="ThemeSelectedBackground"
                                    Grid.Column="0"
                                    BackgroundColor="#E7F3D9"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 23"/>

                            <HorizontalStackLayout Grid.Column="0"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="6">
                                <Image x:Name="LightThemeImage"
                                       Source="{x:Static resx:ImageResources.sun}"
                                       WidthRequest="22"
                                       HeightRequest="22">
                                       <Image.Behaviors>
                                           <toolkit:IconTintColorBehavior x:Name="LightThemeTint"/>
                                       </Image.Behaviors>
                                </Image>
                                <Label x:Name="LightThemeLabel"
                                       Text="{Binding Theme_Light}"
                                       FontSize="14"
                                       TextColor="#1B5E20"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="6">
                                <Image x:Name="DarkThemeImage"
                                       Source="{x:Static resx:ImageResources.moon}"
                                       WidthRequest="22"
                                       HeightRequest="22">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior x:Name="DarkThemeTint"/>
                                    </Image.Behaviors>
                                </Image>
                                <Label x:Name="DarkThemeLabel"
                                       Text="{Binding Theme_Dark}"
                                       FontSize="14"
                                       TextColor="#333333"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeToggleTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </Grid>
            </Frame>

            <!-- Sound -->
            <Frame Padding="16"
                   Margin="15"
                   CornerRadius="20"
                   HasShadow="True"
                   HorizontalOptions="FillAndExpand"
                   Style="{DynamicResource GlobalFrameStyle}">
                <Grid ColumnDefinitions="*,auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Text="{Binding Settings_EnableSound}"
                           FontAttributes="Bold"
                           FontSize="18"
                           VerticalTextAlignment="Center"
                           Style="{DynamicResource GlobalTitleLabelStyle}"/>
                    <Switch x:Name="SoundSwitch"
                            Toggled="OnSoundToggled"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,15,0"
                            Scale="1.4"
                            ThumbColor="#E0E0E0"
                            Style="{DynamicResource GlobalSwitchStyle}" />
                </Grid>
            </Frame>
            
            <HorizontalStackLayout Spacing="35" Padding="0,10,0,0" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button
                    Text="{Binding Reset_Button}"
                    FontSize="18"
                    Clicked="ResetStats"
                    TextColor="White"
                    CornerRadius="15"
                    Padding="16"
                    FontAttributes="Bold"
                    BackgroundColor="#8FBC8F"
                    HorizontalOptions="FillAndExpand">
                </Button>

                <Button
                        Text="{Binding Exit_Button}"
                        FontSize="18"
                        Clicked="Exit"
                        BackgroundColor="#FBC02D"
                        TextColor="#5D4037"
                        CornerRadius="15"
                        Padding="16"
                        FontAttributes="Bold"
                        HorizontalOptions="FillAndExpand">
                </Button>
            </HorizontalStackLayout>
            <!--
            <Button Text="{Binding TestLevelUpButton}"
                    Margin="0,30,0,10"
                    Clicked="OnTestLevelUpClicked"
                    FontSize="15"
                    HorizontalOptions="Center"
                    BackgroundColor="#CFD8DC"
                    TextColor="#263238"
                    CornerRadius="15"
                    Padding="10"
                    FontAttributes="Bold">
            </Button>
            -->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>